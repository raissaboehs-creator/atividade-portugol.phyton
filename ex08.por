programa {
  funcao inicio() {
    //Exemplo-Posistivo ou negativo.
    //Aluno-Raissa Boehs.
    //Objetivo-Ler um número inteiro e informar se ele é posistivo ou negativo, considerando o zero como positivo.

    inteiro n //Declaração da variável.

    escreva("Digite um número: ")//Campo para digitar um número positivo.
    leia(n)//Leitura da variável.

    se(n>=0)//Se o número digitado for maior ou igual a zero ele é positivo.
    escreva("Seu número é positivo.")
    senao //Se o número digitado for menor que zero ele é negativo.
    escreva("Seu número é negativo.")
  }
}
